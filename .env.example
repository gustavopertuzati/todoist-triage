# Copie ce fichier en `.env` pour le développement local, puis remplis les valeurs.
# Ne committe jamais `.env` : il est ignoré par git.
#
# Sur Orkestr, ces variables se saisissent dans la page de l'environnement
# (Environment Variables), pas dans ce fichier.

# Jeton personnel Todoist (Todoist > Paramètres > Intégrations > Développeur).
# Lecture : data:read. Écritures (itération 3) : data:read_write (+ data:delete
# si tu veux supprimer des tâches depuis l'app ; pas nécessaire pour les propositions actuelles).
TODOIST_API_TOKEN=

# Mot de passe unique de l'application. Choisis-le long (12 caractères minimum).
APP_PASSWORD=

# Recommandé : clé aléatoire qui signe le cookie de session.
# Génère-la avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si elle est absente, une clé est dérivée de APP_PASSWORD.
SESSION_SECRET=

# Fuseau utilisé pour « aujourd'hui » et le nom des exports.
APP_TIMEZONE=Europe/Paris

# Port d'écoute local (Orkestr injecte automatiquement le sien).
PORT=3000

# Durée de validité de la session, en jours.
SESSION_TTL_DAYS=30

# Durée du cache mémoire des données Todoist, en secondes (0 = désactivé).
CACHE_TTL_SECONDS=60

# Fenêtre d'analyse des tâches terminées, en jours (maximum 92).
COMPLETED_LOOKBACK_DAYS=90

# Âge minimum d'un projet pour être signalé « sans progression ».
PROJECT_NO_PROGRESS_DAYS=30

# Seuil d'ancienneté d'une tâche, en jours.
OLD_TASK_DAYS=180

# Itération 3 : propositions et écritures.
# Les écritures Todoist ne partent que si une proposition est validée dans l'interface.
# Mets `false` pour désactiver complètement les écritures (l'app reste en lecture).
WRITES_ENABLED=true

# Nombre maximum de propositions proposées par type / au total.
PROPOSALS_MAX_PER_TYPE=15
PROPOSALS_MAX_TOTAL=40

# Décalage par défaut (jours) proposé pour dater une tâche ancienne sans échéance.
PROPOSAL_DUE_OFFSET_DAYS=7

# Itération 4 : propositions datées par une IA (OpenRouter).
# Sans clé, l'app fonctionne normalement en mode règles.
OPENROUTER_API_KEY=
AI_MODEL=deepseek/deepseek-v4.1-flash
# Modèle et budgets. Le plafond de raisonnement évite que le modèle brûle tout
# le budget en réflexion avant d'écrire le JSON.
AI_MAX_TOKENS=8000
AI_REASONING_MAX_TOKENS=400
AI_MAX_PROPOSALS=5
AI_HORIZON_DAYS=120
AI_TIMEOUT_MS=90000
# Durée de mise en cache des propositions IA, en minutes (0 = pas de cache).
AI_CACHE_TTL_MINUTES=30
# Mets `false` pour désactiver l'IA même si la clé est présente.
AI_ENABLED=true

# Uniquement pour les tests locaux avec un faux serveur Todoist. À ne pas définir en production.
# TODOIST_BASE_URL=http://127.0.0.1:3999/api/v1
